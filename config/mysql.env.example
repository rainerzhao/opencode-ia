# Copy to config/mysql.env locally, replace both passwords with unique random values, then:
# docker compose --env-file config/mysql.env -f compose.mysql.yaml up -d
WORKBENCH_MYSQL_DATABASE=opencode_ia
WORKBENCH_MYSQL_USER=opencode_app
WORKBENCH_MYSQL_PASSWORD=
WORKBENCH_MYSQL_ROOT_PASSWORD=
WORKBENCH_MYSQL_PORT=33067
