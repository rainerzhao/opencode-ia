[Unit]
Description=OpenCode Team AI Workbench
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opencode
Group=opencode
WorkingDirectory=/opt/opencode-ia
StateDirectory=opencode-workbench
StateDirectoryMode=0700
UMask=0077
Environment=NODE_ENV=production
Environment=WORKBENCH_DATA_DIR=/var/lib/opencode-workbench
Environment=XDG_DATA_HOME=/var/lib/opencode-workbench/xdg/data
Environment=XDG_STATE_HOME=/var/lib/opencode-workbench/xdg/state
Environment=XDG_CONFIG_HOME=/var/lib/opencode-workbench/xdg/config
Environment=XDG_CACHE_HOME=/var/lib/opencode-workbench/xdg/cache
EnvironmentFile=/etc/opencode-workbench/workbench.env
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/opencode-workbench/runtime
ExecStart=/usr/bin/node /opt/opencode-ia/scripts/start-production.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/opencode-workbench
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
