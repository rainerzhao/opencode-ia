# Copy to .env, review paths, then export it in your shell.
# Provider credentials belong only in OpenCode's protected configuration.

# WORKBENCH_ROOT=/absolute/path/to/opencode-ia
# PORT=3000
# MAX_SESSIONS=20
# OPENCODE_CMD=/absolute/path/to/opencode
# OPENCODE_CWD=/absolute/path/to/opencode-workspace
# OPENCODE_TIMEOUT_MS=120000
# OPENCODE_MAX_OUTPUT_BYTES=10485760
# OPENCODE_WORKER_BASE_PORT=4319
# OPENCODE_WORKER_STARTUP_TIMEOUT_MS=10000
# OPENCODE_WORKER_READINESS_INTERVAL_MS=100
# OPENCODE_WORKER_STOP_GRACE_MS=2000
# OPENCODE_WORKER_KILL_GRACE_MS=1000
# OPENCODE_WORKER_USERNAME=opencode
# OPENCODE_VERIFIED_VERSION=1.18.25
# KNOWLEDGE_DIR=/absolute/path/to/opencode-ia/knowledge
# SOLUTIONS_DIR=/absolute/path/to/opencode-ia/solutions
# SKILLS_DIR=/absolute/path/to/opencode-workspace/.opencode/skills
# DATABASE_PATH=/absolute/path/to/opencode-ia/data/workbench.db
# UPLOAD_TEMP_DIR=/absolute/path/to/opencode-ia/data/tmp/uploads
# COOKIE_SECURE=false
# SESSION_TTL_SECONDS=28800
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SECONDS=900
# LOGIN_LOCK_SECONDS=900

# URL import is disabled by default. Exact hosts only; include non-default ports.
# KNOWLEDGE_FETCH_ALLOWED_HOSTS=docs.example.com,docs.example.com:8443
